<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/maven-v4_0_0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <name>JFreeChart-2.0</name>

    <artifactId>jfreechart</artifactId>
    <groupId>org.jfree</groupId>
    <version>2.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <organization>
        <name>JFree.org</name>
        <url>http://www.jfree.org/</url>
    </organization>
    <inceptionYear>2001</inceptionYear>

    <description>
        JFreeChart is a class library, written in Java, for generating charts. 
        Utilising the Java2D API, it supports a wide range of chart types including
        bar charts, pie charts, line charts, XY-plots, time series plots, Sankey charts
        and more.
    </description>

    <url>http://www.jfree.org/jfreechart/</url>
    <issueManagement>
        <url>https://github.com/jfree/jfreechart/issues</url>
        <system>GitHub Issues</system>
    </issueManagement>
    <scm>
        <connection>scm:git:git:https://github.com/jfree/jfreechart.git</connection>
        <url>https://github.com/jfree/jfreechart</url>
    </scm>

    <developers>
      <developer>
        <name>David Gilbert</name>
        <email>dave@jfree.org</email>
      </developer>
    </developers>

    <licenses>
        <license>
            <name>GNU Lesser General Public Licence</name>
            <url>http://www.gnu.org/licenses/lgpl.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.release.level>11</project.release.level>
        <project.source.level>11</project.source.level>
        <project.target.level>11</project.target.level>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>5.8.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>5.8.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <distributionManagement>
        <snapshotRepository>
          <id>ossrh</id>
          <url>https://oss.sonatype.org/content/repositories/snapshots</url>
        </snapshotRepository>
    </distributionManagement>    
    
    <build>
        <testSourceDirectory>src/test/java</testSourceDirectory>
        <plugins>

            <plugin>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-maven</artifactId>
                <version>1.18.2</version>
                <dependencies>
                <dependency>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-junit5-plugin</artifactId>
                <version>1.2.2</version>
                </dependency>
                </dependencies>
                <configuration>
                <!-- Target the production classes (all classes in org.jfree) -->
                <targetClasses>
             



                <param>org.jfree.chart.plot.CategoryCrosshairState</param> 
                <param>org.jfree.chart.plot.CategoryMarker</param> 
                <param>org.jfree.chart.plot.CategoryPlot</param> 
                <param>org.jfree.chart.plot.CenterTextMode</param> 
                <param>org.jfree.chart.plot.CombinedDomainCategoryPlot</param> 
                <param>org.jfree.chart.plot.CombinedDomainXYPlot</param> 
                <param>org.jfree.chart.plot.CombinedRangeCategoryPlot</param> 
                <param>org.jfree.chart.plot.CombinedRangeXYPlot</param> 
                <param>org.jfree.chart.plot.Crosshair</param> 
                <param>org.jfree.chart.plot.CrosshairState</param> 
                <param>org.jfree.chart.plot.DatasetRenderingOrder</param> 
                <param>org.jfree.chart.plot.DefaultDrawingSupplier</param>
                <param>org.jfree.chart.plot.DialShape</param> 
                <param>org.jfree.chart.plot.DrawingSupplier</param> 
                <param>org.jfree.chart.plot.FastScatterPlot</param> 
                <param>org.jfree.chart.plot.IntervalMarker</param>
                <param>org.jfree.chart.plot.Marker</param>
                <param>org.jfree.chart.plot.MeterInterval</param> 
                <param>org.jfree.chart.plot.MeterPlot</param> 
                <param>org.jfree.chart.plot.package-info</param> 
                <param>org.jfree.chart.plot.Pannable</param>
                <param>org.jfree.chart.plot.Plot</param> 
                <param>org.jfree.chart.plot.PlotOrientation</param> 
                <param>org.jfree.chart.plot.PlotRenderingInfo</param>
                <param>org.jfree.chart.plot.PlotState</param> 
                <param>org.jfree.chart.plot.PolarAxisLocation</param>
                <param>org.jfree.chart.plot.PolarPlot</param>
                <param>org.jfree.chart.plot.RingPlot</param> 
                <param>org.jfree.chart.plot.SeriesRenderingOrder</param>
                <param>org.jfree.chart.plot.SpiderWebPlot</param> 
                <param>org.jfree.chart.plot.ThermometerPlot</param> 
                <param>org.jfree.chart.plot.ValueAxisPlot</param>
                <param>org.jfree.chart.plot.ValueMarker</param> 
                <param>org.jfree.chart.plot.WaferMapPlot</param>
                <param>org.jfree.chart.plot.XYCrosshairState</param>
                <param>org.jfree.chart.plot.XYPlot</param> 
                <param>org.jfree.chart.plot.Zoomable</param>

                




                </targetClasses>
                <!-- Target only test classes, e.g. those ending with Test -->
                <targetTests>
            
               
<param>org.jfree.chart.plot.CategoryMarkerTest</param> <param>org.jfree.chart.plot.CategoryPlotTest</param> <param>org.jfree.chart.plot.CombinedDomainCategoryPlotTest</param> <param>org.jfree.chart.plot.CombinedDomainXYPlotTest</param> <param>org.jfree.chart.plot.CombinedRangeCategoryPlotTest</param> <param>org.jfree.chart.plot.CombinedRangeXYPlotTest</param> <param>org.jfree.chart.plot.CrosshairTest</param> <param>org.jfree.chart.plot.DefaultDrawingSupplierTest</param> <param>org.jfree.chart.plot.FastScatterPlotTest</param> <param>org.jfree.chart.plot.IntervalMarkerTest</param> <param>org.jfree.chart.plot.MarkerTest</param> <param>org.jfree.chart.plot.MeterIntervalTest</param> <param>org.jfree.chart.plot.MeterPlotTest</param> <param>org.jfree.chart.plot.MyPlotChangeListener</param> <param>org.jfree.chart.plot.PlotOrientationTest</param> <param>org.jfree.chart.plot.PlotRenderingInfoTest</param> <param>org.jfree.chart.plot.PlotTest</param> <param>org.jfree.chart.plot.PolarPlotTest</param> <param>org.jfree.chart.plot.RingPlotTest</param> <param>org.jfree.chart.plot.SpiderWebPlotTest</param> <param>org.jfree.chart.plot.ThermometerPlotTest</param> <param>org.jfree.chart.plot.ValueMarkerTest</param> <param>org.jfree.chart.plot.XYPlotTest</param>
                




                </targetTests>
                <!-- Explicitly instruct PIT to use JUnit 5 -->
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <version>3.2.0</version>
            </plugin>            

<plugin>
    <groupId>org.jacoco</groupId>
    <artifactId>jacoco-maven-plugin</artifactId>
    <version>0.8.12</version>
    <executions>
        <execution>
            <goals>
                <goal>prepare-agent</goal>
            </goals>
        </execution>
        <execution>
            <id>report</id>
            <phase>prepare-package</phase>
            <goals>
                <goal>report</goal>
            </goals>
        </execution>
    </executions>
</plugin>

<plugin>
  <groupId>com.github.spotbugs</groupId>
  <artifactId>spotbugs-maven-plugin</artifactId>
  <version>4.9.3.0</version>
  <dependencies>
    <!-- overwrite dependency on spotbugs if you want to specify the version of spotbugs -->
    <dependency>
      <groupId>com.github.spotbugs</groupId>
      <artifactId>spotbugs</artifactId>
      <version>4.9.3</version>
    </dependency>
  </dependencies>
</plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.10.1</version>
                <configuration>
                    <release>${project.release.level}</release>
                    <source>${project.source.level}</source>
                    <target>${project.target.level}</target>
                    <encoding>${project.build.sourceEncoding}</encoding>                
                    <showWarnings>true</showWarnings>
                    <showDeprecation>true</showDeprecation>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.2.2</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.4.0</version>
                <configuration>
                    <linksource>true</linksource>
                    <source>11</source>
                    <docfilessubdirs>true</docfilessubdirs>
                </configuration>
            </plugin>
            
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.0.0-M7</version>
            </plugin>
            <plugin>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>3.0.0-M7</version>
            </plugin>       

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.2.0</version>
                <configuration>
                    <encoding>${project.build.sourceEncoding}</encoding>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-install-plugin</artifactId>
                <version>3.0.0-M1</version>
            </plugin>
          
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-site-plugin</artifactId>
                <version>3.10.0</version>
            </plugin>
        </plugins>
    </build>

    <reporting>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-report-plugin</artifactId>
                <version>3.0.0-M5</version>
            </plugin>
                
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jxr-plugin</artifactId>
                <version>3.1.1</version>
            </plugin>

        </plugins>
    </reporting>

    <profiles>
        <profile> 
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>1.5</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin> 

                    <plugin>
                        <groupId>org.sonatype.plugins</groupId>
                        <artifactId>nexus-staging-maven-plugin</artifactId>
                        <version>1.6.7</version>
                        <extensions>true</extensions>
                        <configuration>
                            <serverId>ossrh</serverId>
                            <nexusUrl>https://oss.sonatype.org/</nexusUrl>
                            <autoReleaseAfterClose>false</autoReleaseAfterClose>
                        </configuration>
                    </plugin>

                    <plugin>
                        <inherited>true</inherited>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.3.1</version>
                        <configuration>
                            <docfilessubdirs/>
                            <linksource>true</linksource>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadoc</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.2.0</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
